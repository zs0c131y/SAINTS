# Public site origin, used for canonical URLs, the sitemap and social tags.
NEXT_PUBLIC_SITE_URL=https://saints.christuniversity.in

# Google Sheet that drives the content (tab names are fixed, see src/lib/sheet.ts).
SHEET_ID=1T8OY51wObS-MhN7tSpAHnSGPJ143aYBVnnUFK51E2jU

# Seconds a fetched sheet tab is cached before the next request refreshes it.
SHEET_REVALIDATE_SECONDS=60

# Secret for POST /api/revalidate (refresh the site right after editing the sheet). Leave empty to disable.
REVALIDATE_SECRET=

# Google Tag Manager container. Leave empty to disable analytics.
NEXT_PUBLIC_GTM_ID=GTM-WCSXFZ7L
